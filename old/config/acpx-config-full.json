{
  "$schema": "https://raw.githubusercontent.com/openclaw/acpx/main/config.schema.json",

  "defaultAgent": "codex",
  "defaultPermissions": "approve-all",
  "nonInteractivePermissions": "deny",
  "authPolicy": "skip",
  "ttl": 300,

  "agents": {
    "trae": {
      "command": "trae-cli acp serve",
      "description": "ByteDance Trae - fastest, Chinese optimized"
    }
  },

  "categories": {
    "ultrabrain": {
      "agent": "claude",
      "runtime": "subagent",
      "description": "Complex architecture, deep reasoning"
    },
    "deep": {
      "agent": "claude",
      "runtime": "subagent",
      "description": "Multi-file refactoring, complex logic"
    },
    "visual-engineering": {
      "agent": "trae",
      "runtime": "acp",
      "description": "Frontend UI, CSS, prototypes"
    },
    "standard": {
      "agent": "codex",
      "runtime": "acp",
      "description": "Regular development, CRUD, APIs"
    },
    "quick": {
      "agent": "trae",
      "runtime": "acp",
      "description": "Single file, small changes"
    },
    "writing": {
      "agent": "trae",
      "runtime": "subagent",
      "description": "Documentation, comments"
    },
    "explore": {
      "agent": "codex",
      "runtime": "subagent",
      "description": "Code search, research"
    }
  },

  "relay_fallback": {
    "enabled": true,
    "timeout_sec": 75,
    "fallback_chain": ["acp", "direct_acpx", "subagent"],
    "telemetry_dir": "~/.openclaw/telemetry"
  },

  "background_task": {
    "defaultConcurrency": 3,
    "providerConcurrency": {
      "anthropic": 2,
      "openai": 2,
      "trae": 3
    }
  }
}
