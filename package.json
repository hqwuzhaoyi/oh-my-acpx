{
  "name": "oma",
  "version": "0.2.0",
  "private": true,
  "description": "OMA context-saving auxiliary offload sidecar for host agents using ACPX.",
  "type": "commonjs",
  "bin": {
    "oma": "dist/src/cli/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/unit/*.js",
    "setup": "npm run build && node dist/src/cli/index.js setup"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  }
}
